# Backend storage mode.
# Use "memory" for local prototype data, or "supabase" for persistent storage.
XHS_STORAGE_BACKEND=memory

# Supabase backend-only credentials. Never expose the service role key in frontend code.
XHS_SUPABASE_URL=
XHS_SUPABASE_SERVICE_ROLE_KEY=
XHS_SUPABASE_STORAGE_BUCKET=xhs-assets
XHS_SUPABASE_SSL_VERIFY=true
XHS_SUPABASE_SEED_SAMPLE=false

# Optional backend settings.
XHS_API_HOST=127.0.0.1
XHS_API_PORT=8787
XHS_CORS_ORIGIN=*

# Alibaba Cloud Model Studio AnimateAnyone (Beijing region API Key).
# DASHSCOPE_API_KEY can be used instead of XHS_VIDEO_API_KEY.
XHS_VIDEO_PROVIDER=aliyun_dashscope_animate_anyone
XHS_VIDEO_API_BASE=https://dashscope.aliyuncs.com/api/v1
XHS_VIDEO_API_KEY=
XHS_VIDEO_MODEL=animate-anyone-gen2
XHS_VIDEO_DETECT_MODEL=animate-anyone-detect-gen2
XHS_VIDEO_TEMPLATE_MODEL=animate-anyone-template-gen2
XHS_VIDEO_MOTION_MODEL=wan2.2-animate-move
XHS_VIDEO_SSL_VERIFY=true
XHS_VIDEO_POLL_INTERVAL=5
XHS_VIDEO_MAX_WAIT=1800
